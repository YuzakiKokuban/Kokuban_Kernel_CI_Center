+/* sus_kstat */
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+static DEFINE_MUTEX(susfs_mutex_lock_sus_kstat);
+static DEFINE_HASHTABLE(SUS_KSTAT_HLIST, 14);
